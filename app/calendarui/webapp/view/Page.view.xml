<mvc:View
    controllerName="calendarui.calendarui.controller.Page"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:unified="sap.ui.unified"
    xmlns="sap.m">
    <VBox class="sapUiSmallMargin">
        <PlanningCalendar
            id="PC1"
            startDate="{calendar>/startDate}"
            rows="{calendar>/people}"
            appointmentsVisualization="Filled"
            appointmentSelect="handleAppointmentSelect"
            rowHeaderPress="handleRowHeaderPress"
            showEmptyIntervalHeaders="false"
            showWeekNumbers="true">
            <toolbarContent>
                <Title text="Employee Planning Calendar" titleStyle="H4" />
                <Select id="primaryCalendarTypeSelect" change="onCalendarTypeSelect" selectedKey="None">
                    <core:Item key="Gregorian" text="Gregorian" />
                    <core:Item key="Islamic" text="Islamic" />
                    <core:Item key="Japanese" text="Japanese" />
                    <core:Item key="Persian" text="Persian" />
                    <core:Item key="Buddhist" text="Buddhist" />
                </Select>
                <Select id="secondaryCalendarTypeSelect" change="onCalendarSecondaryTypeSelect" selectedKey="None">
                    <core:Item text="Select secondary calendar type" key="None" />
                    <core:Item key="Gregorian" text="Gregorian" />
                    <core:Item key="Islamic" text="Islamic" />
                    <core:Item key="Japanese" text="Japanese" />
                    <core:Item key="Persian" text="Persian" />
                    <core:Item key="Buddhist" text="Buddhist" />
                </Select>
            </toolbarContent>
            <rows>
                <PlanningCalendarRow
                    icon="{calendar>pic}"
                    title="{calendar>name}"
                    text="{calendar>role}"
                    appointments="{calendar>appointments}"
                    intervalHeaders="{calendar>headers}">
                    <customData>
                        <core:CustomData key="emp-name" value="{calendar>name}" writeToDom="true" />
                    </customData>
                    <appointments>
                        <unified:CalendarAppointment
                            startDate="{calendar>start}"
                            endDate="{calendar>end}"
                            icon="{calendar>pic}"
                            title="{calendar>title}"
                            text="{calendar>info}"
                            type="{calendar>type}"
                            tentative="{calendar>tentative}" />
                    </appointments>
                    <intervalHeaders>
                        <unified:CalendarAppointment
                            startDate="{calendar>start}"
                            endDate="{calendar>end}"
                            icon="{calendar>pic}"
                            title="{calendar>title}"
                            type="{calendar>type}" />
                    </intervalHeaders>
                </PlanningCalendarRow>
            </rows>
        </PlanningCalendar>

        <Label text="Add available built-in views to the example:" />
        <MultiComboBox
            selectionFinish="handleSelectionFinish"
            width="230px"
            placeholder="Choose built-in views">
            <items>
                <core:Item key="Hour" text="Hour" />
                <core:Item key="Day" text="Day" />
                <core:Item key="Month" text="Month" />
                <core:Item key="Week" text="1 week" />
                <core:Item key="One Month" text="1 month" />
            </items>
        </MultiComboBox>
    </VBox>
</mvc:View>

{
  "name": "SFSFExtension",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@graphql-tools/schema": "^10.0.23",
    "@sap-cloud-sdk/connectivity": "^3",
    "@sap-cloud-sdk/http-client": "^3",
    "@sap-cloud-sdk/resilience": "^3",
    "@sap/cds": "^8",
    "@sap/cds-hana": "^2.1.0",
    "@sap/cds-odata-v2-adapter-proxy": "^1.9.21",
    "@sap/hana-client": "^2.25.22",
    "cds-swagger-ui-express": "^0.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4",
    "express-graphql": "^0.12.0",
    "graphql": "^16.11.0",
    "multer": "^2.0.0",
    "ui5-cc-spreadsheetimporter": "^2.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.10.0",
    "@sap/cds-dk": "^8"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-calendar": "cds watch --open calendar/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-calendarui": "cds watch --open calendarui/webapp/index.html?sap-ui-xx-viewCache=false"
  },
  "globals": {
    "SELECT": true,
    "INSERT": true,
    "UPDATE": true,
    "DELETE": true,
    "CREATE": true,
    "DROP": true,
    "CDL": true,
    "CQL": true,
    "CXL": true,
    "cds": true
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "hana",
        "pool": {
      "min": 1,
      "max": 10
    },
        "vcap": {
          "label": "hana",
          "plan": "hdi-shared"
        }
      },
      "ECPersonalInformation": {
        "kind": "odata-v2",
        "model": "srv/external/ECPersonalInformation",
        "credentials": {
          "destination": "SFSF",
          "path": "/odata/v2"
        }
      },
      "ECTimeOff": {
        "kind": "odata-v2",
        "model": "srv/external/ECTimeOff",
        "credentials": {
          "destination": "SFSF",
          "path": "/odata/v2"
        }
      }
    },
    "preview": {
      "ui5": {
        "version": "1.97.0",
        "theme": "sap_horizon"
      }
    },
    "features": {
      "preserve_computed": true,
      "kibana_formatter": true,
      "audit_personal_data": true,
      "optimized_search": true,
      "rest_new_adapter": true,
      "graphql": true
    }
  },
  "sapux": [
    "app/calendar"
  ]
}
